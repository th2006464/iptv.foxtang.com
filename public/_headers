/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Cross-Origin-Resource-Policy: same-origin
  Content-Security-Policy: default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'none'; script-src 'self' https://cdn.jsdelivr.net; style-src 'self'; img-src 'self' data: https: http:; media-src 'self' https: http: blob:; connect-src 'self' https: http:; worker-src 'self' blob:; font-src 'self'; upgrade-insecure-requests

# HTML and JS/CSS must revalidate after deploy. The HTML references a versioned
# stylesheet/module to avoid Safari mixing an old layout with new markup.
/index.html
  Cache-Control: no-cache, must-revalidate

/src/*
  Cache-Control: no-cache, must-revalidate
